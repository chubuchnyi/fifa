# pitch3d machine-specific configuration — copy to `.env` and edit for your machine.
#
#   cp .env.example .env   &&   $EDITOR .env
#
# `.env` is gitignored (never committed). It is read by both shell scripts
# (`set -a; . .env; set +a`) and Python (`from pitch3d.env import load_env`).
# Anything already exported in your environment overrides the file.

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL machine — where you run `scripts/demo.sh` (the laptop/workstation).
# ─────────────────────────────────────────────────────────────────────────────
# Repo root (absolute). Leave blank to let demo.sh use its own location.
PITCH3D_REPO_LOCAL=/home/you/AVATAR
# Python venv interpreter (needs torch + smplx + matplotlib for the mesh export).
PITCH3D_PY_LOCAL=.venv/bin/python
# Blender 5.x binary for the photoreal Cycles mesh render.
PITCH3D_BLENDER=/home/you/Downloads/blender-5.1.2-linux-x64/blender
# SMPL-X model dir (must contain smplx/SMPLX_NEUTRAL.npz). Licensed, NOT in git.
PITCH3D_SMPLX_MODELS=/home/you/AVATAR/SMPL-X/models

# ─────────────────────────────────────────────────────────────────────────────
# RUNPOD access — needed only for the full real-GPU demo (not for --local).
# The API key is read by runpodctl from ~/.runpod/config.toml — never put it here.
# ─────────────────────────────────────────────────────────────────────────────
# runpodctl binary (blank = found on PATH, else ~/.local/bin/runpodctl).
RUNPODCTL=
# SSH private key that reaches the pods.
POD_SSH_KEY=~/.ssh/id_ed25519_runpod
# jq name-regex selecting your pods.
POD_NAME_GLOB=pitch3d

# ─────────────────────────────────────────────────────────────────────────────
# ON-POD paths — the GPU box layout on the persistent /workspace volume.
# These defaults match the staged volume; override only if yours differs.
# ─────────────────────────────────────────────────────────────────────────────
PITCH3D_REPO=/workspace/fifa
PITCH3D_PY=/workspace/.venv/bin/python
PITCH3D_CLIP=/workspace/clip.mp4
PITCH3D_DEVICE=cuda
# Pose backend (SMPLest-X-H): checkout + the FK model dir holding smplx/*.npz.
PITCH3D_SMPLESTX_REPO=/workspace/repos/SMPLest-X
PITCH3D_SMPLX_MODEL_PATH=/workspace/repos/SMPLest-X/human_models/human_model_files
# Ball backend (WASB).
PITCH3D_WASB_REPO=/workspace/repos/WASB-SBDT
PITCH3D_WASB_CKPT=/workspace/weights/wasb/wasb_soccer_best.pth.tar
PITCH3D_WASB_DATASET=soccer
# Calibration backend (PnLCalib) — OPTIONAL. Leave PNLCALIB_REPO blank to run the
# demo with the proxy calibrator; set it once the repo + weights are staged.
PNLCALIB_REPO=
PNLCALIB_WEIGHTS_KP=/workspace/weights/pnlcalib/SV_kp
PNLCALIB_WEIGHTS_LINES=/workspace/weights/pnlcalib/SV_lines

# ─────────────────────────────────────────────────────────────────────────────
# DATASET access — gated datasets needing a password/NDA. Blank unless you have
# access; never commit the real value (`.env` is gitignored).
# ─────────────────────────────────────────────────────────────────────────────
# SoccerNet original broadcast videos (NDA). Read by the official `SoccerNet`
# pip downloader: SoccerNetDownloader(...).password = os.environ["SOCCERNET_PASSWORD"].
# Request access at soccer-net.org (sign the NDA); the password arrives by email.
SOCCERNET_PASSWORD=
