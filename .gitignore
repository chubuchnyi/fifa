# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Machine-specific config (absolute paths / access details). Template: .env.example
.env

# Claude Code runtime state (local-only: lock files, scheduled-task bookkeeping)
.claude/

# Project runtime artifacts (content-addressable cache, dry-run outputs)
.cache/
out/
*.npz
!tests/**/*.npz
# Measured camera fits (kB-sized, minutes to recompute, and only reproducible from a video
# that is not in the repo — see scripts/fit_rigid_camera.py).
!calib/*.npz

# Local sample media (large; not part of the repo)
samples/

# Model weights (large; downloaded on demand by the heavy adapters, e.g. RF-DETR base)
*.pth
*.pt
*.onnx
*.safetensors
*.pkl

# Licensed body models — must NOT enter the public repo (non-commercial MPI SMPL-X
# license). Local downloads/model workspace: the saved download page + the 830 MB model.
/SMPL-X/

# Datasets (large / gated; live outside git — e.g. WorldPose annotations + footage).
/data/
/WorldPose/

# Box-local heavy/GPL backend glue injected via the ADR-0006 dotted-path seam
# (e.g. PnLCalib calibrator) — lives on the GPU box, must NOT enter the public repo.
/backends/

# Throwaway box-management / validation helpers (underscore-prefixed) — they reach into
# RunPod / local secrets and are not part of the public repo.
/scripts/_*

# poseannot user-uploaded clip bundles (video + scene.json; large, runtime-only)
/poseannot/clips/
